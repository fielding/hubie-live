{
  "manifest_version": 3,
  "name": "Hubie Housebets Bridge",
  "version": "0.3.5",
  "description": "Lets the local Hubie show runner see and press the Housebets game it plays on stream.",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://housebets.com/*",
    "https://*.housebets.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://housebets.com/*",
        "https://*.housebets.com/*"
      ],
      "js": [
        "focus.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://housebets.com/*",
        "https://*.housebets.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "alarms",
    "scripting",
    "storage"
  ]
}